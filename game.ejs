<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>الغرفة</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <header class="bar">
    <div>الغرفة: <%= roomId %></div>
    <nav>
      <button class="btn" id="start">بدء الجولة</button>
      <a class="btn light" href="/lobby">خروج</a>
    </nav>
  </header>

  <main class="game">
    <aside class="panel">
      <h3>اللاعبون</h3>
      <ul id="players"></ul>
      <h3>الحالة</h3>
      <div id="status">بانتظار البدء…</div>
    </aside>

    <section class="stage">
      <canvas id="stageCanvas"></canvas>
    </section>
  </main>

  <script>
    const roomId = "<%= roomId %>";
    const user = <%- JSON.stringify({ id: user.id, displayName: user.displayName }) %>;
  </script>
  <script src="/webrtc.js"></script>
  <script src="/client.js"></script>
</body>
</html>
